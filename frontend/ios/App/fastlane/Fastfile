require "digest"
require "fileutils"
require "open3"
require "shellwords"
require "time"

default_platform(:ios)

platform :ios do
  desc "Build and upload RMC Classics to TestFlight using the App Store Connect API key"
  lane :testflight do
    app_version = get_version_number(
      xcodeproj: "App.xcodeproj",
      target: "App"
    )

    asc_key_id = ENV.fetch("ASC_KEY_ID")
    asc_issuer_id = ENV.fetch("ASC_ISSUER_ID")
    UI.user_error!("App Store Connect key ID is invalid") unless asc_key_id.match?(/\A[A-Z0-9]{10}\z/)
    UI.user_error!("App Store Connect issuer ID is invalid") unless asc_issuer_id.match?(/\A[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\z/i)
    asc_key_id_sha256 = Digest::SHA256.hexdigest(asc_key_id)
    asc_issuer_id_sha256 = Digest::SHA256.hexdigest(asc_issuer_id)

    api_key = app_store_connect_api_key(
      key_id: asc_key_id,
      issuer_id: asc_issuer_id,
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: true,
      in_house: false
    )

    latest_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.rmcclassics.app",
      version: app_version,
      initial_build_number: 14
    )
    expected_build_number = latest_build + 1
    increment_build_number(
      build_number: expected_build_number,
      xcodeproj: "App.xcodeproj"
    )

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      output_directory: "build/ios/ipa",
      xcargs: "-allowProvisioningUpdates"
    )

    ipa_path = File.expand_path("build/ios/ipa/App.ipa", Dir.pwd)
    verify_dir = File.expand_path("build/ios/ipa/verify", Dir.pwd)
    FileUtils.mkdir_p(verify_dir)
    sh("unzip -q #{Shellwords.escape(ipa_path)} -d #{Shellwords.escape(verify_dir)}")
    app_paths = Dir[File.join(verify_dir, "Payload", "*.app")]
    UI.user_error!("Expected exactly one application bundle in the IPA") unless app_paths.length == 1
    app_path = app_paths.first
    sh("codesign --verify --deep --strict #{Shellwords.escape(app_path)}")
    signing_info = sh(
      "codesign -dv --verbose=4 #{Shellwords.escape(app_path)} 2>&1"
    )
    signing_authority = signing_info.lines.find { |line|
      line.start_with?("Authority=")
    }&.split("=", 2)&.last&.strip
    UI.user_error!("Signed IPA must use an Apple Distribution certificate") unless signing_authority&.start_with?("Apple Distribution")
    certificate_prefix = File.join(verify_dir, "signing-certificate-")
    sh(
      "codesign -d --extract-certificates #{Shellwords.escape(certificate_prefix)} " \
      "#{Shellwords.escape(app_path)}"
    )
    leaf_certificate = "#{certificate_prefix}0"
    UI.user_error!("Signed IPA leaf certificate was not extracted") unless File.file?(leaf_certificate) && File.size?(leaf_certificate)
    certificate_minimum_validity_days = 30
    sh(
      "openssl x509 -inform DER " \
      "-checkend #{certificate_minimum_validity_days * 86_400} " \
      "-noout -in #{Shellwords.escape(leaf_certificate)}"
    )
    certificate_not_after = sh(
      "openssl x509 -inform DER -enddate -noout -in " \
      "#{Shellwords.escape(leaf_certificate)}"
    ).sub(/\AnotAfter=/, "").strip
    UI.user_error!("Signing certificate expiration is unavailable") if certificate_not_after.empty?

    profile_path = File.join(app_path, "embedded.mobileprovision")
    UI.user_error!("Signed IPA is missing its embedded provisioning profile") unless File.file?(profile_path) && File.size?(profile_path)
    profile_plist = File.join(verify_dir, "embedded-profile.plist")
    sh(
      "security cms -D -i #{Shellwords.escape(profile_path)} > " \
      "#{Shellwords.escape(profile_plist)}"
    )
    certificate_verifier = File.expand_path(
      "../../../scripts/verify_ios_profile_certificate.py", Dir.pwd
    )
    profile_certificate_digest_path = File.join(
      verify_dir, "profile-certificate.sha256"
    )
    sh(
      "python3 #{Shellwords.escape(certificate_verifier)} --profile " \
      "#{Shellwords.escape(profile_plist)} --certificate " \
      "#{Shellwords.escape(leaf_certificate)} --digest-file " \
      "#{Shellwords.escape(profile_certificate_digest_path)}"
    )
    profile_certificate_digest = File.read(
      profile_certificate_digest_path, encoding: "UTF-8"
    ).strip
    UI.user_error!("Profile certificate digest is invalid") unless profile_certificate_digest.match?(/\A[0-9a-f]{64}\z/)
    profile_application_identifier = get_info_plist_value(
      path: profile_plist, key: "Entitlements:application-identifier"
    )
    signed_entitlements = File.join(verify_dir, "signed-entitlements.plist")
    sh(
      "codesign -d --entitlements :- #{Shellwords.escape(app_path)} > " \
      "#{Shellwords.escape(signed_entitlements)}"
    )
    signed_application_identifier = get_info_plist_value(
      path: signed_entitlements, key: "application-identifier"
    )
    signed_team_identifier = get_info_plist_value(
      path: signed_entitlements,
      key: "com.apple.developer.team-identifier"
    )
    signed_get_task_allow = get_info_plist_value(
      path: signed_entitlements, key: "get-task-allow"
    )
    profile_get_task_allow = get_info_plist_value(
      path: profile_plist, key: "Entitlements:get-task-allow"
    )
    profile_beta_reports_active = get_info_plist_value(
      path: profile_plist, key: "Entitlements:beta-reports-active"
    )
    profile_team_identifier = get_info_plist_value(
      path: profile_plist,
      key: "Entitlements:com.apple.developer.team-identifier"
    )
    profile_top_level_team_identifier, profile_team_error, profile_team_status = Open3.capture3(
      "/usr/libexec/PlistBuddy", "-c", "Print :TeamIdentifier:0",
      profile_plist
    )
    UI.user_error!("Provisioning profile top-level team identifier is missing: #{profile_team_error.strip}") unless profile_team_status.success?
    profile_top_level_team_identifier = profile_top_level_team_identifier.strip
    profile_expiration = get_info_plist_value(
      path: profile_plist, key: "ExpirationDate"
    )
    profile_uuid = get_info_plist_value(path: profile_plist, key: "UUID")
    profile_name = get_info_plist_value(path: profile_plist, key: "Name")
    UI.user_error!("Provisioning profile UUID is missing") if profile_uuid.to_s.empty?
    UI.user_error!("Provisioning profile name is missing") if profile_name.to_s.empty?
    _, _, provisioned_devices_status = Open3.capture3(
      "/usr/libexec/PlistBuddy", "-c", "Print :ProvisionedDevices",
      profile_plist
    )
    UI.user_error!("App Store profile must not target provisioned devices") if provisioned_devices_status.success?
    provisions_all_devices, _, all_devices_status = Open3.capture3(
      "/usr/libexec/PlistBuddy", "-c", "Print :ProvisionsAllDevices",
      profile_plist
    )
    if all_devices_status.success? && ["true", "1"].include?(provisions_all_devices.strip.downcase)
      UI.user_error!("App Store profile must not use enterprise all-device distribution")
    end

    info_plist = File.join(app_path, "Info.plist")
    bundle_id = get_info_plist_value(path: info_plist, key: "CFBundleIdentifier")
    verified_version = get_info_plist_value(
      path: info_plist, key: "CFBundleShortVersionString"
    )
    verified_build = get_info_plist_value(path: info_plist, key: "CFBundleVersion")
    UI.user_error!("IPA build number must be numeric") unless verified_build.to_s.match?(/\A[0-9]+\z/)
    UI.user_error!("Unexpected IPA bundle identifier") unless bundle_id == "com.rmcclassics.app"
    UI.user_error!("Provisioning profile team identifiers do not agree") unless profile_top_level_team_identifier == profile_team_identifier
    expected_application_identifier = "#{profile_team_identifier}.#{bundle_id}"
    UI.user_error!("Provisioning profile does not authorize the IPA bundle identifier") unless profile_application_identifier == expected_application_identifier
    UI.user_error!("Signed app identifier does not match its provisioning profile") unless signed_application_identifier == profile_application_identifier
    UI.user_error!("Signed team identifier does not match its provisioning profile") unless signed_team_identifier == profile_team_identifier
    debuggable_values = [true, 1, "true", "1"]
    UI.user_error!("Signed App Store IPA must disable get-task-allow") if debuggable_values.include?(signed_get_task_allow)
    UI.user_error!("App Store profile must disable get-task-allow") if debuggable_values.include?(profile_get_task_allow)
    app_store_distribution_values = [true, 1, "true", "1"]
    UI.user_error!("App Store profile must enable beta-reports-active") unless app_store_distribution_values.include?(profile_beta_reports_active)
    begin
      profile_expiration_time = Time.parse(profile_expiration.to_s)
    rescue ArgumentError
      UI.user_error!("Provisioning profile expiration is invalid")
    end
    profile_minimum_validity_days = 30
    UI.user_error!("Provisioning profile must remain valid for at least #{profile_minimum_validity_days} days") unless (
      profile_expiration_time > Time.now + (profile_minimum_validity_days * 86_400)
    )
    UI.user_error!("IPA marketing version does not match the reviewed Xcode version") unless verified_version.to_s == app_version.to_s
    UI.user_error!("IPA build number does not match the reserved TestFlight build") unless verified_build.to_s == expected_build_number.to_s

    receipt_path = File.expand_path(
      "build/ios/ipa/release-ipa-metadata.txt", Dir.pwd
    )
    repository = ENV.fetch("GITHUB_REPOSITORY", "ldavis2700/rmc-classics")
    expected_commit = ENV.fetch("SOURCE_COMMIT") {
      ENV.fetch("GITHUB_SHA") {
        sh("git rev-parse --verify 'HEAD^{commit}'").strip
      }
    }
    commit = sh("git rev-parse --verify 'HEAD^{commit}'").strip
    UI.user_error!("TestFlight checkout does not match the pinned source commit") unless (
      expected_commit.match?(/\A[0-9a-f]{40}\z/) && commit == expected_commit
    )
    app_store_apple_id = ENV.fetch("APP_STORE_APPLE_ID")
    UI.user_error!("App Store Apple ID must be numeric") unless app_store_apple_id.match?(/\A[1-9][0-9]+\z/)
    File.write(receipt_path, [
      "repository=#{repository}",
      "commit=#{commit}",
      "app_store_apple_id=#{app_store_apple_id}",
      "asc_key_id_sha256=#{asc_key_id_sha256}",
      "asc_issuer_id_sha256=#{asc_issuer_id_sha256}",
      "bundle_id=#{bundle_id}",
      "version=#{verified_version}",
      "reviewed_marketing_version=#{app_version}",
      "build_number=#{verified_build}",
      "reserved_build_number=#{expected_build_number}",
      "profile_application_identifier=#{profile_application_identifier}",
      "profile_top_level_team_identifier=#{profile_top_level_team_identifier}",
      "signed_application_identifier=#{signed_application_identifier}",
      "signed_team_identifier=#{signed_team_identifier}",
      "signing_authority=#{signing_authority}",
      "signing_certificate_not_after=#{certificate_not_after}",
      "certificate_minimum_validity_days=#{certificate_minimum_validity_days}",
      "profile_certificate_sha256=#{profile_certificate_digest}",
      "profile_uuid=#{profile_uuid}",
      "profile_name=#{profile_name}",
      "signed_get_task_allow=#{signed_get_task_allow}",
      "profile_get_task_allow=#{profile_get_task_allow}",
      "profile_beta_reports_active=#{profile_beta_reports_active}",
      "profile_expiration=#{profile_expiration_time.utc.iso8601}",
      "profile_minimum_validity_days=#{profile_minimum_validity_days}",
      "artifact=#{ipa_path}",
      "sha256=#{Digest::SHA256.file(ipa_path).hexdigest}",
    ].join("\n") + "\n")

    receipt_lines = File.readlines(receipt_path, chomp: true)
    required_receipt_keys = %w[
      repository commit app_store_apple_id asc_key_id_sha256
      asc_issuer_id_sha256 bundle_id version
      reviewed_marketing_version build_number reserved_build_number
      profile_application_identifier profile_top_level_team_identifier
      signed_application_identifier signed_team_identifier signing_authority
      signing_certificate_not_after certificate_minimum_validity_days
      profile_certificate_sha256 profile_uuid
      profile_name signed_get_task_allow profile_get_task_allow
      profile_beta_reports_active profile_expiration
      profile_minimum_validity_days artifact sha256
    ]
    required_receipt_keys.each do |key|
      count = receipt_lines.count { |line| line.start_with?("#{key}=") }
      UI.user_error!("Release receipt must contain exactly one #{key} field") unless count == 1
    end
    {
      "repository" => repository,
      "commit" => commit,
      "app_store_apple_id" => app_store_apple_id,
      "asc_key_id_sha256" => asc_key_id_sha256,
      "asc_issuer_id_sha256" => asc_issuer_id_sha256,
      "bundle_id" => bundle_id,
      "version" => verified_version.to_s,
      "reviewed_marketing_version" => app_version.to_s,
      "build_number" => verified_build.to_s,
      "reserved_build_number" => expected_build_number.to_s,
      "profile_application_identifier" => profile_application_identifier,
      "profile_top_level_team_identifier" => profile_top_level_team_identifier,
      "signed_application_identifier" => signed_application_identifier,
      "signed_team_identifier" => signed_team_identifier,
      "signing_authority" => signing_authority,
      "signing_certificate_not_after" => certificate_not_after,
      "certificate_minimum_validity_days" => certificate_minimum_validity_days.to_s,
      "profile_certificate_sha256" => profile_certificate_digest,
      "profile_uuid" => profile_uuid,
      "profile_name" => profile_name,
      "signed_get_task_allow" => signed_get_task_allow.to_s,
      "profile_get_task_allow" => profile_get_task_allow.to_s,
      "profile_beta_reports_active" => profile_beta_reports_active.to_s,
      "profile_expiration" => profile_expiration_time.utc.iso8601,
      "profile_minimum_validity_days" => profile_minimum_validity_days.to_s,
      "artifact" => ipa_path,
    }.each do |key, value|
      UI.user_error!("Release receipt #{key} binding mismatch") unless receipt_lines.include?("#{key}=#{value}")
    end
    recorded_profile_sha256 = receipt_lines.find { |line| line.start_with?("profile_certificate_sha256=") }&.split("=", 2)&.last
    UI.user_error!("Release receipt profile certificate digest is invalid") unless recorded_profile_sha256&.match?(/\A[0-9a-f]{64}\z/)
    recorded_ipa_sha256 = receipt_lines.find { |line| line.start_with?("sha256=") }&.split("=", 2)&.last
    UI.user_error!("Release receipt IPA digest is invalid") unless recorded_ipa_sha256&.match?(/\A[0-9a-f]{64}\z/)
    UI.user_error!("Release receipt IPA digest mismatch") unless recorded_ipa_sha256 == Digest::SHA256.file(ipa_path).hexdigest

    receipt_checksum_path = "#{receipt_path}.sha256"
    receipt_checksum = Digest::SHA256.file(receipt_path).hexdigest
    File.write(
      receipt_checksum_path,
      "#{receipt_checksum}  #{File.basename(receipt_path)}\n"
    )
    recorded_receipt_sha256, recorded_receipt_name = File.read(
      receipt_checksum_path
    ).strip.split(/\s+/, 2)
    UI.user_error!("Release receipt checksum is invalid") unless recorded_receipt_sha256&.match?(/\A[0-9a-f]{64}\z/)
    UI.user_error!("Release receipt checksum path is invalid") unless recorded_receipt_name == File.basename(receipt_path)
    UI.user_error!("Release receipt checksum mismatch") unless recorded_receipt_sha256 == Digest::SHA256.file(receipt_path).hexdigest

    upload_to_testflight(
      api_key: api_key,
      app_identifier: bundle_id,
      apple_id: app_store_apple_id,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end
end
