require "digest"
require "fileutils"
require "shellwords"
require "time"

default_platform(:ios)

platform :ios do
  desc "Build and upload RMC Classics to TestFlight using the App Store Connect API key"
  lane :testflight do
    app_version = get_version_number(
      xcodeproj: "App.xcodeproj",
      target: "App"
    )

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: true,
      in_house: false
    )

    latest_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.rmcclassics.app",
      version: app_version,
      initial_build_number: 14
    )
    increment_build_number(
      build_number: latest_build + 1,
      xcodeproj: "App.xcodeproj"
    )

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      output_directory: "build/ios/ipa",
      xcargs: "-allowProvisioningUpdates"
    )

    ipa_path = File.expand_path("build/ios/ipa/App.ipa", Dir.pwd)
    verify_dir = File.expand_path("build/ios/ipa/verify", Dir.pwd)
    FileUtils.mkdir_p(verify_dir)
    sh("unzip -q #{Shellwords.escape(ipa_path)} -d #{Shellwords.escape(verify_dir)}")
    app_paths = Dir[File.join(verify_dir, "Payload", "*.app")]
    UI.user_error!("Expected exactly one application bundle in the IPA") unless app_paths.length == 1
    app_path = app_paths.first
    sh("codesign --verify --deep --strict #{Shellwords.escape(app_path)}")

    profile_path = File.join(app_path, "embedded.mobileprovision")
    UI.user_error!("Signed IPA is missing its embedded provisioning profile") unless File.file?(profile_path) && File.size?(profile_path)
    profile_plist = File.join(verify_dir, "embedded-profile.plist")
    sh(
      "security cms -D -i #{Shellwords.escape(profile_path)} > " \
      "#{Shellwords.escape(profile_plist)}"
    )
    profile_application_identifier = get_info_plist_value(
      path: profile_plist, key: "Entitlements:application-identifier"
    )
    signed_entitlements = File.join(verify_dir, "signed-entitlements.plist")
    sh(
      "codesign -d --entitlements :- #{Shellwords.escape(app_path)} > " \
      "#{Shellwords.escape(signed_entitlements)}"
    )
    signed_application_identifier = get_info_plist_value(
      path: signed_entitlements, key: "application-identifier"
    )
    signed_team_identifier = get_info_plist_value(
      path: signed_entitlements,
      key: "com.apple.developer.team-identifier"
    )
    signed_get_task_allow = get_info_plist_value(
      path: signed_entitlements, key: "get-task-allow"
    )
    profile_get_task_allow = get_info_plist_value(
      path: profile_plist, key: "Entitlements:get-task-allow"
    )
    profile_team_identifier = get_info_plist_value(
      path: profile_plist,
      key: "Entitlements:com.apple.developer.team-identifier"
    )
    profile_expiration = get_info_plist_value(
      path: profile_plist, key: "ExpirationDate"
    )

    info_plist = File.join(app_path, "Info.plist")
    bundle_id = get_info_plist_value(path: info_plist, key: "CFBundleIdentifier")
    verified_version = get_info_plist_value(
      path: info_plist, key: "CFBundleShortVersionString"
    )
    verified_build = get_info_plist_value(path: info_plist, key: "CFBundleVersion")
    UI.user_error!("Unexpected IPA bundle identifier") unless bundle_id == "com.rmcclassics.app"
    expected_application_identifier = "#{profile_team_identifier}.#{bundle_id}"
    UI.user_error!("Provisioning profile does not authorize the IPA bundle identifier") unless profile_application_identifier == expected_application_identifier
    UI.user_error!("Signed app identifier does not match its provisioning profile") unless signed_application_identifier == profile_application_identifier
    UI.user_error!("Signed team identifier does not match its provisioning profile") unless signed_team_identifier == profile_team_identifier
    debuggable_values = [true, 1, "true", "1"]
    UI.user_error!("Signed App Store IPA must disable get-task-allow") if debuggable_values.include?(signed_get_task_allow)
    UI.user_error!("App Store profile must disable get-task-allow") if debuggable_values.include?(profile_get_task_allow)
    begin
      profile_expiration_time = Time.parse(profile_expiration.to_s)
    rescue ArgumentError
      UI.user_error!("Provisioning profile expiration is invalid")
    end
    UI.user_error!("Provisioning profile is expired") unless profile_expiration_time > Time.now
    UI.user_error!("IPA marketing version is missing") if verified_version.to_s.empty?
    UI.user_error!("IPA build number must be numeric") unless verified_build.to_s.match?(/\A[0-9]+\z/)

    receipt_path = File.expand_path(
      "build/ios/ipa/release-ipa-metadata.txt", Dir.pwd
    )
    repository = ENV.fetch("GITHUB_REPOSITORY", "ldavis2700/rmc-classics")
    commit = ENV.fetch("GITHUB_SHA") {
      sh("git rev-parse --verify 'HEAD^{commit}'").strip
    }
    File.write(receipt_path, [
      "repository=#{repository}",
      "commit=#{commit}",
      "bundle_id=#{bundle_id}",
      "version=#{verified_version}",
      "build_number=#{verified_build}",
      "profile_application_identifier=#{profile_application_identifier}",
      "signed_application_identifier=#{signed_application_identifier}",
      "signed_team_identifier=#{signed_team_identifier}",
      "signed_get_task_allow=#{signed_get_task_allow}",
      "profile_get_task_allow=#{profile_get_task_allow}",
      "profile_expiration=#{profile_expiration_time.utc.iso8601}",
      "sha256=#{Digest::SHA256.file(ipa_path).hexdigest}",
    ].join("\n") + "\n")

    upload_to_testflight(
      api_key: api_key,
      ipa: "build/ios/ipa/App.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
